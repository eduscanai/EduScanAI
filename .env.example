# Configurações da aplicação
NUXT_PUBLIC_API_URL=http://localhost:3000/api

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-anon-key
# Necessária para as rotas de servidor que usam serverSupabaseServiceRole
# (envios em lote, correção, simulados). Pegue em Project Settings > API >
# service_role (secreta — nunca exponha no client).
SUPABASE_SERVICE_KEY=sua-service-role-key

# Microserviço de correção OMR (ver /service no repo omrchecker)
OMR_SERVICE_URL=http://127.0.0.1:8010
OMR_SERVICE_TOKEN=defina-um-segredo-compartilhado
